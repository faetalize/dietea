{
  "name": "dietea",
  "version": "1.0.0",
  "type": "module",
  "description": "Meal prep planner backed by Supabase",
  "scripts": {
    "dev": "npx live-server --ignore=data --ignorePattern=\"(\\.crswap$|Zone\\.Identifier$)\" --port=3000",
    "start": "npx live-server --ignore=data --ignorePattern=\"(\\.crswap$|Zone\\.Identifier$)\" --port=3000",
    "test": "node --test",
    "vendor:markdown": "esbuild scripts/markdown-entry.js --bundle --format=esm --platform=browser --target=es2020 --minify --legal-comments=none --outfile=js/vendor/markdown.js",
    "vendor:supabase": "esbuild scripts/supabase-entry.js --bundle --format=esm --platform=browser --target=es2020 --minify --legal-comments=none --outfile=js/vendor/supabase.js"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "esbuild": "^0.25.0",
    "marked": "^18.0.7"
  },
  "keywords": ["meal-prep", "nutrition", "vanilla-js", "supabase"],
  "license": "MIT"
}
